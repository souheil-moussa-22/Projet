<?xml version="1.0" encoding="utf-8"?>
<!--
    Formulaire d'ajout de trajet.
    TP1 : EditText, TextView, Button, RadioGroup
    TP4 : AutoCompleteTextView pour les villes
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Ajouter un trajet"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="24dp" />

        <!-- ── Ville de départ ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ville de départ *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <!-- AutoCompleteTextView : suggère des villes dès la 1ère lettre (TP4) -->
        <AutoCompleteTextView
            android:id="@+id/etDepart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : Paris"
            android:completionThreshold="1"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <!-- ── Ville d'arrivée ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ville d'arrivée *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <AutoCompleteTextView
            android:id="@+id/etDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : Lyon"
            android:completionThreshold="1"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp" />

        <!-- ── Date ─────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date (JJ/MM/AAAA) *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 10/06/2025"
            android:inputType="datetime"
            android:layout_marginBottom="16dp" />

        <!-- ── Nombre de places ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de places *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPlaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 3"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- ── Type d'utilisateur (RadioGroup - TP1) ─────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vous êtes : *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/rbConducteur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚗 Conducteur"
                android:checked="true"
                android:layout_marginEnd="24dp" />

            <RadioButton
                android:id="@+id/rbPassager"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧍 Passager" />

        </RadioGroup>

        <!-- ── Bouton Enregistrer ────────────────────────────────────────── -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾  Enregistrer le trajet"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
